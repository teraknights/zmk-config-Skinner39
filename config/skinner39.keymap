        scroll_layer {
            bindings = <
  &trans  &kp F7  &kp F8  &kp F9  &kp F10                  &trans  &trans           &trans            &trans           &trans
  &trans  &kp F4  &kp F5  &kp F6  &kp F11                  &trans  &msc MOVE_X(15)  &msc MOVE_Y(-15)  &msc MOVE_X(15)  &msc MOVE_X(-15)
  &trans  &kp F1  &kp F2  &kp F3  &kp F12                  &trans  &mkp LCLK        &msc MOVE_Y(10)   &mkp RCLK        &trans
  &trans  &trans  &trans  &trans  &trans   &trans  &trans  &trans                                                      &trans
            >;
