#include "keycode_japanese.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/pointing.h>

#include <zmk/event_manager.h>
#include <zmk/events/mouse_move_state_changed.h>
#include <zmk/layers.h>
#include <zmk/keymap.h>
#include <zmk/timer.h>


#define SCROLL_LAYER 1
#define DEFAULT_LAYER 0

static struct k_timer trackball_timer;

static void trackball_timer_handler(struct k_timer *dummy) {
    zmk_layer_deactivate(SCROLL_LAYER);
    zmk_layer_activate(DEFAULT_LAYER);
}

static int trackball_movement_listener(const zmk_event_t *eh) {
    const struct zmk_mouse_move_state_changed *ev = as_zmk_mouse_move_state_changed(eh);
    if (ev == NULL) {
        return ZMK_EV_EVENT_BUBBLE;
    }

    if (ev->x != 0 || ev->y != 0) {
        zmk_layer_activate(SCROLL_LAYER);
        zmk_layer_deactivate(DEFAULT_LAYER);
        k_timer_start(&trackball_timer, K_SECONDS(2), K_NO_WAIT);
    }

    return ZMK_EV_EVENT_BUBBLE;
}

ZMK_LISTENER(trackball_movement_listener, trackball_movement_listener);
ZMK_SUBSCRIPTION(trackball_movement_listener, zmk_mouse_move_state_changed);

void main(void) {
    // ...existing code...
    k_timer_init(&trackball_timer, trackball_timer_handler, NULL);
    // ...existing code...
}


/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
  &kp Q         &kp W      &kp E       &kp R          &kp T                                      &kp Y      &kp U  &kp I      &kp O      &mt RIGHT_ALT P
  &kp A         &kp S      &kp D       &kp F          &kp G                                      &kp H      &kp J  &kp K      &kp L      &kp BACKSPACE
  &mt LSHFT Z   &kp X      &kp C       &kp V          &kp B                                      &kp N      &kp M  &mkp LCLK  &mkp RCLK  &lt 5 MINUS
  &kp LEFT_WIN  &kp COMMA  &kp PERIOD  &mt LCTRL TAB  &lt 5 SPACE  &lt 1 LANG2  &mt LCTRL LANG1  &lt 3 RET                               &lt 2 ESCAPE
            >;
        };

        symbol {
            bindings = <
  &kp JP_PRCNT  &kp JP_DLLR   &kp JP_AMPS   &kp JP_CARET  &kp JP_SLASH                  &kp JP_BSLH   &kp JP_LBRC  &kp JP_RBRC  &kp JP_LT    &kp JP_RT
  &kp JP_AT     &kp JP_HASH   &kp JP_ASTRK  &kp JP_PLUS   &kp JP_EQUAL                  &kp JP_UNDER  &kp JP_LPAR  &kp JP_RPAR  &kp JP_SEMI  &kp JP_COLON
  &kp JP_GRAVE  &kp JP_TILDE  &kp JP_YEN    &kp JP_EXCL   &kp JP_QMARK                  &kp JP_PIPE   &kp JP_LBKT  &kp JP_RBKT  &kp JP_SQT   &kp JP_DQT
  &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans                                               &trans
            >;
        };

        symbol_layer {
            bindings = <
  &kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp DOLLAR    &kp PERCENT                  &kp CARET       &kp AMPERSAND  &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
  &bt BT_CLR       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans                       &kp MINUS       &kp EQUAL      &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &kp SQT
  &trans           &trans        &trans        &trans        &trans                       &kp UNDERSCORE  &kp PLUS       &trans            &trans                &kp BACKSLASH
  &trans           &trans        &trans        &trans        &trans       &trans  &trans  &trans                                                                 &trans
            >;
